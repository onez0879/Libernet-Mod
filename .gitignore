# Router-specific state. Never publish credentials, generated caches, or logs.
#
# NOTE: the package tree nests the OpenWrt root as files/root/root/, so real
# paths always contain the doubled "root/root". Keep patterns in sync.

# Live system config (holds the web UI username/password).
package/libernet-mod/files/root/root/libernet/system/config.json

# Generated caches and databases.
package/libernet-mod/files/root/root/libernet/system/cache.db
package/libernet-mod/files/root/root/libernet/cache.db

# Runtime logs.
package/libernet-mod/files/root/root/libernet/log/*.log

# Private keys and certificates. stunnel points at stunnel.pem; ship a
# placeholder instead so no real key ever lands in Git.
package/libernet-mod/files/root/root/libernet/bin/config/stunnel/*.pem

# User connection profiles: these carry live SSH/proxy credentials.
package/libernet-mod/files/root/root/libernet/bin/config/*/*.json
package/libernet-mod/files/root/root/libernet/bin/config/*/*.conf

# Local build output.
*.ipk
build_dir/
