#!/bin/sh /etc/rc.common

USE_PROCD=1
NAME=libernet
START=80
STOP=20
BIN=/root/libernet/bin/service.sh

start_service() {
    procd_open_instance
    procd_set_param command "$BIN"
    procd_set_param respawn 3600 10 1
    procd_set_param limits nofile="65535"
    procd_close_instance
}

stop_service() {
    # service.sh has its own cancel_services; just kill the process.
    killall -9 service.sh 2>/dev/null
}

restart() {
    stop
    start
}
