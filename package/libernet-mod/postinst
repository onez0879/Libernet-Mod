#!/bin/sh
#
# postinst libernet-mod
# Setup runtime setelah opkg install / upgrade.
#

# Jangan jalan saat build image (opkg di dalam ImageBuilder)
[ -n "${IPKG_INSTROOT}" ] && exit 0

LIBDIR="/root/libernet"
CFG="$LIBDIR/system/config.json"
CFGDEF="$LIBDIR/system/config.default.json"

# ---------------------------------------------------------------------------
# 1. Script bin/*.sh harus executable.
#    Tanpa ini service.sh, qload.sh, v2ray.sh dkk gagal dijalankan.
# ---------------------------------------------------------------------------
if [ -d "$LIBDIR/bin" ]; then
    chmod +x "$LIBDIR/bin/"*.sh 2>/dev/null
fi

# ---------------------------------------------------------------------------
# 2. Seed config.json dari config.default.json kalau belum ada.
#    api.php baca/tulis ke config.json; tanpa file ini semua save gagal.
# ---------------------------------------------------------------------------
if [ ! -f "$CFG" ] && [ -f "$CFGDEF" ]; then
    cp "$CFGDEF" "$CFG"
    chmod 600 "$CFG"
fi

# ---------------------------------------------------------------------------
# 3. Direktori runtime.
# ---------------------------------------------------------------------------
mkdir -p "$LIBDIR/log" 2>/dev/null

# ---------------------------------------------------------------------------
# 4. Daftarkan PHP-CGI ke uhttpd supaya /libernet/*.php dieksekusi,
#    bukan diunduh mentah. Idempotent: tidak dobel kalau sudah ada.
# ---------------------------------------------------------------------------
if command -v uci >/dev/null 2>&1; then
    if ! uci -q get uhttpd.main.interpreter 2>/dev/null | grep -q '/usr/bin/php-cgi'; then
        uci -q add_list uhttpd.main.interpreter='.php=/usr/bin/php-cgi'
        uci commit uhttpd
        /etc/init.d/uhttpd reload >/dev/null 2>&1 \
            || /etc/init.d/uhttpd restart >/dev/null 2>&1
    fi
fi

exit 0
